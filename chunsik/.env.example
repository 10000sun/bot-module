# 이 파일을 복사해서 이름을 .env 로 바꾼 뒤 값을 채우세요.
# 값 뒤에 주석(#)을 달지 마세요. 줄 전체를 값으로 읽습니다.

# 디스코드 봇 토큰 (개발자 포털 → Bot → Reset Token)
DISCORD_TOKEN=

# Gemini API 키 (Google AI Studio → Get API key). 비워두면 AI 대화 기능만 꺼집니다.
GEMINI_API_KEY=

# ===== 🚨 다운 알림 =====
# 관리자만 보는 채널에 웹훅을 만들어 URL을 넣으세요.
# (채널 설정 → 연동 → 웹훅 → 새 웹훅 → 웹훅 URL 복사)
# 비워두면 알림 기능만 조용히 꺼지고 봇은 정상 동작합니다.
ALERT_WEBHOOK_URL=

# 알림에 함께 멘션할 대상 (선택). 예: <@123456789012345678> 또는 <@&123456789012345678>
ALERT_MENTION=

# 게이트웨이가 몇 초 넘게 끊겨 있을 때 알릴지 (기본 60초)
ALERT_DISCONNECT_SECONDS=60

# ===== 📁 데이터 폴더 =====
# 비워두면 main.py 옆의 data/ 폴더를 씁니다. 보통은 비워두면 됩니다.
# 서버 한 대에서 여러 봇을 돌릴 때만 봇마다 다른 경로를 지정하세요.
# 예: CHUNSIK_DATA_DIR=D:\봇데이터\에바스
CHUNSIK_DATA_DIR=

# ===== ⚡ 개발용 =====
# 테스트 서버 ID를 넣으면 슬래시 명령이 그 서버에 **즉시** 동기화됩니다.
# (비워두면 전체 동기화 — 디스코드가 퍼뜨리는 데 최대 1시간 걸려요)
# 🚨 납품할 때는 반드시 비우세요. 켜져 있으면 그 서버에서만 명령이 보입니다.
CHUNSIK_TEST_GUILD=
